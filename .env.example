# LLM Provider: groq | gemini | openai | ollama
LLM_PROVIDER=groq

GROQ_API_KEY=your_groq_api_key_here

# Gemini (free tier) - get from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (optional, paid)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama (local, free) - model must be pulled: ollama pull llava
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava
OLLAMA_TEXT_MODEL=llama3.2

# Confidence thresholds
CONFIDENCE_THRESHOLD_LOW=0.6       # below this = uncertain
CONFIDENCE_THRESHOLD_HIGH=0.85     # above this = high confidence

# DB
DB_PATH=./data/trade_docs.db

# RAG store (per-shipment FAISS pickles)
RAG_STORE_PATH=./data/rag_store

# Logging — DEBUG | INFO | WARNING | ERROR. Logs stream to console + ./logs/trade_pipeline.log
LOG_LEVEL=INFO
LOG_DIR=./logs

# Gmail watcher (Part 2 — optional). See documentation/GMAIL_SETUP.md
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=gmail_token.json
GMAIL_POLL_INTERVAL=10
# GMAIL_CUSTOMER_MAP=acme-exports.com:CUST001,fastfreight.net:CUST002
